# Copy this file to .env.local and fill in real values from the Supabase and
# Wild Apricot dashboards. .env.local is gitignored — never commit real
# secrets. In production these are set in the Vercel/Supabase project
# dashboards instead of a file.

# Supabase dashboard → Connect (or Settings → API Keys)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=           # public — safe in frontend code (sb_publishable_...)
SUPABASE_SECRET_KEY=                # SECRET — server-side only, never in frontend code (sb_secret_...)

# Wild Apricot authorized application (see js/waAuth.js header for setup steps)
WA_CLIENT_ID=                       # public — safe in frontend code
WA_CLIENT_SECRET=                   # SECRET — server-side only, never in frontend code
